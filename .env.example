# Optional overrides — logmein-mcp has no required env vars.
# Authentication is per-request via two request headers, matching MSPbots'
# own stored credential fields for this integration:
#   X-LogMeIn-Username — the LogMeIn Rescue account email/username
#   X-LogMeIn-Password — the corresponding password
# This server performs a fresh login (POST/GET login.aspx) on every single
# tool call to obtain a short-lived ASP.NET session cookie, then makes the
# real API call with that cookie in the same request — nothing is cached
# or persisted across calls. See README Known Gaps for why the vendor's
# "authcode" field (also present in MSPbots' stored test credentials) is
# not used by this server.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
